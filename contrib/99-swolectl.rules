# Permit the Tonal 1 controller to enter USB runtime suspend when no process
# holds its CDC ACM port open. The application wakes it by reopening the port.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="1cbe", ATTR{idProduct}=="00a1", TEST=="power/control", ATTR{power/control}="auto", ATTR{power/autosuspend_delay_ms}="0"
